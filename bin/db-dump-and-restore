#!/usr/bin/env fish --no-config

set DIR (dirname (readlink -f (status --current-filename)))

source "$DIR/../config/fish/functions/db-dump.fish"
source "$DIR/../config/fish/functions/db-restore.fish"

if [ (count $argv) -ne 2 ]
  echo "Usage: db-dump-and-restore <connection string> <local_db_name>" >&2
  return 1
end

set connection_string $argv[1]
set local_db_name $argv[2]

if psql -Atc "SELECT datname FROM pg_database;" | rg $local_db_name
  dropdb $local_db_name
  or return 1
end

set -f dumpfile (mktemp)
echo "Dumping to temp file..." >&2
db-dump $connection_string $dumpfile
and db-restore $local_db_name $dumpfile
# Use `command` to bypass my alias so it's quiet and not verbose
command rm $dumpfile
