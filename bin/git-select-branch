#!/usr/bin/env fish --no-config

source ~/.config/fish/stdlib.fish

# Only 1 branch
if [ $(git branch $argv | wc -l | xargs echo) = 1 ]
  echo "$(basename $0): There's only one git branch, exiting." >&2
  exit 1
end

function select_branch
  set current_branch $(git rev-parse --abbrev-ref HEAD)
  git branch --sort=-committerdate --color=always $argv |
    sed -E -e 's/^[[:space:]]*//' -e 's@^remotes/@@' |
    rg -v '^\*' |
    rg -v "remotes/origin/$current_branch" |
    rg -v "remotes/origin/HEAD" |
    fzf --multi --reverse --ansi --exit-0 --preview="git find-best-log $current_branch {} --color=always --" |
    sed -e 's@^remotes/origin/@@'
end

set branches $(select_branch $argv)

if string match -rq '^\+ ' $branches
  set branch_without_plus_prefix $(string match -rg '^\+ (.+)' $branches)
  set worktree_dir $(git worktree list --no-porcelain | rg $branch_without_plus_prefix | awk '{print $1}')
  error "That branch is being used by a worktree! To remove it, run:"
  error "git worktree remove $worktree_dir"
  exit 1
else
  # Echo 1 by 1 so that each branch is on its own line.
  # Fish splits on newlines, not spaces, so Fish scripts that consume this one's output need each
  # ranch on its own line otherwise it thinks it's all one big branch name if you select multiple
  # branches.
  for branch in $branches
    echo $branch
  end
end
